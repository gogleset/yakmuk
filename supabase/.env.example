# 로컬 Auth 외부 프로바이더 — 값을 채운 뒤 supabase/config.toml 에서
# [auth.external.google] / [auth.external.apple] 의 enabled = true 로 바꾸고
# `supabase stop && supabase start`
#
# 이 파일은 커밋 OK. 실제 값은 supabase/.env 에 복사 (커밋 금지).

# Google — Web Client ID 맨 앞, 이어서 Android/iOS Client ID (콤마, 공백 없이)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=123-web.apps.googleusercontent.com,123-android.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=GOCSPX-...

# Apple — iOS Bundle ID (네이티브). Secret JWT는 Apple provider enable 시
# SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.yakmuk.app
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# env(VAR) 치환이 깨지지 않게, 키를 아직 안 넣었으면 빈 문자라도 선언:
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
