# 로컬 Supabase (iOS Sim). Android Emulator는 10.0.2.2 사용.
# BE(기본 54321)와 동시 기동 — yakmuk API는 54421 (supabase/config.toml)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS 프로젝트 ID (eas init). 미설정 시 app.config.js 기본값 사용.
EXPO_PUBLIC_EAS_PROJECT_ID=caacddee-a434-402f-ad91-74114dba43d8

# 공공데이터포털 인증키 (식약처 e약은요). 포털에서 받은 URL-인코딩 키를 그대로 넣기.
# https://www.data.go.kr/data/15075057/openapi.do
EXPO_PUBLIC_DATA_GO_KR_SERVICE_KEY=

# 가족장 Google 네이티브 — Web Client ID만 (Secret 넣지 말 것)
# Google Cloud → 웹 애플리케이션 Client ID
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-web.apps.googleusercontent.com

# Google/Apple 키·supabase/.env 미설정 시 Welcome의 개발용 이메일 로그인 사용.
